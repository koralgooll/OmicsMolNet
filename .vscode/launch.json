{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "internalConsole",
            "justMyCode": false
        },
        {
            "name": "Scraper: --ids O00462",
            "type": "debugpy",
            "request": "launch",
            "module": "omicsmolnet_scraper_agent.cli",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--ids", "O00462",
                "--log-level", "DEBUG"
            ]
        },
        {
            "name": "Scraper: --config ids.yaml",
            "type": "debugpy",
            "request": "launch",
            "module": "omicsmolnet_scraper_agent.cli",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--config", "/home/cezary/science/OmicsMolNet/packages/scraper_agent/configs/ids.yaml",
                "--log-level", "DEBUG"
            ]
        },
        {
            "name": "Pytest: core tests (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "internalConsole",
            "justMyCode": false,
            "args": [
                "${file}",
                "-q"
            ]
        }
    ]
}