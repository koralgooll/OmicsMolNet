{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "internalConsole",
            "justMyCode": false
        },
        {
            "name": "TMP RUN Scraper: --ids P02649",
            "type": "debugpy",
            "request": "launch",
            "module": "omicsmolnet_scraper_agent.cli",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--ids", "P02649",
                "--log-level", "DEBUG"
            ]
        },
        {
            "name": "Phase 1 (config): --config ids.yaml",
            "type": "debugpy",
            "request": "launch",
            "module": "omicsmolnet_scraper_agent.cli",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--output", "${workspaceFolder}/output/results_phase_1_config.json",
                "--config", "/home/cezary/science/OmicsMolNet/packages/scraper_agent/configs/ids.yaml",
                "--log-level", "DEBUG"
            ]
        },
        {
            "name": "Phase 1 (ids): --ids O00462",
            "type": "debugpy",
            "request": "launch",
            "module": "omicsmolnet_scraper_agent.cli",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--output", "${workspaceFolder}/output/results_phase_1_ids.json",
                "--ids", "O00462",
                "--log-level", "DEBUG"
            ]
        },
        {
            "name": "Phase 2 (config): --input results_phase_1_config.json",
            "type": "debugpy",
            "request": "launch",
            "module": "omicsmolnet_scraper_agent.cli_pdf",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--input", "${workspaceFolder}/output/results_phase_1_config.json",
                "--output-dir", "${workspaceFolder}/output/out_phase_2_config/",
                "--output", "${workspaceFolder}/output/results_phase_2_config.json",
                "--log-level", "DEBUG"
            ]
        },
        {
            "name": "Phase 2 (ids): --input results_phase_1_ids.json",
            "type": "debugpy",
            "request": "launch",
            "module": "omicsmolnet_scraper_agent.cli_pdf",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--input", "${workspaceFolder}/output/results_phase_1_ids.json",
                "--output-dir", "${workspaceFolder}/output/out_phase_2_ids/",
                "--output", "${workspaceFolder}/output/results_phase_2_ids.json",
                "--log-level", "DEBUG"
            ]
        },
        {
            "name": "Pytest: core tests (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "internalConsole",
            "justMyCode": false,
            "args": [
                "${file}",
                "-q"
            ]
        }
    ]
}